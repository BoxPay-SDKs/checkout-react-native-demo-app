{
  "expo": {
    "name": "Boxpay Checkout React Native",
    "slug": "checkout-react-native-demo-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "checkoutreactnativedemoapp",
    "userInterfaceStyle": "automatic",
    "fonts": [
      "./assets/fonts/NotoSans-Regular.ttf",
      "./assets/fonts/NotoSans-Medium.ttf",
      "./assets/fonts/NotoSans-SemiBold.ttf",
      "./assets/fonts/NotoSans-Bold.ttf",
      "./assets/fonts/NotoSans-ExtraBold.ttf"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ishikabansal1601.checkoutreactnativedemoapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ishikabansal1601.checkoutreactnativedemoapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "./plugins/withAndroidGradlePlugin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f180349-7bb2-4204-93da-0ad694ed6095"
      }
    }
  }
}
